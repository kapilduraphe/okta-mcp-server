{
  "name": "okta-mcp-server",
  "version": "1.0.0",
  "description": "An MCP server for using Okta APIs",
  "type": "module",
  "license": "MIT",
  "bin": {
    "mcp-server-okta": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
